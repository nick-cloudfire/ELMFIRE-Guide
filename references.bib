@article{bihariUnderstandingRolePlanners2012,
	title = {Understanding the {Role} of {Planners} in {Wildfire} {Preparedness} and {Mitigation}},
	volume = {2012},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2090-892X},
	url = {https://www.hindawi.com/journals/isrn/2012/253028/},
	doi = {10.5402/2012/253028},
	abstract = {As wildfires affect more residential areas across the United States, the need for collaboration between land managers, federal agencies, neighbours, and local governments has become more pressing especially in the context of the wildland-urban interface. Previous research has not focused much on land-use planners’ role in wildfire mitigation. This paper provides information on how land-use planners can assist communities in learning to live with wildfire risk through planning, preparedness, and mitigation efforts in the wildland-urban interface (WUI). Based on interviews with land-use planners, forest planners, and local emergency management officials, we identified a range of tools that could be used for improving wildfire preparedness and mitigation initiatives in the WUI, but also found that planners felt that they lacked the regulatory authority to use these tenaciously. The paper also identifies a range of possible actions that would contribute towards safer building practices in the interface communities.},
	language = {en},
	urldate = {2026-04-30},
	journal = {ISRN Forestry},
	author = {Bihari, Menka and Hamin, Elisabeth M. and Ryan, Robert L.},
	month = mar,
	year = {2012},
	pages = {1--12},
}

